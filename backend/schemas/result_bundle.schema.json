      "type": "string"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/Assessment"
      },
      "title": "Assessments",
      "type": "array"
    },
    "dataset_kind": {
      "enum": [
        "synthetic",
        "manual",
        "model",
        "unanalyzed"
      ],
