      "properties": {
        "measure": {
          "title": "Measure",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "measure"
      ],
      "title": "EvidenceMeasure",
      "type": "object"
    },
