            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "USER",
                "OPPONENT",
                "UNRESOLVED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "rule_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Version"
        },
        "schema_version": {
          "default": "phase1b_v1",
          "title": "Schema Version",
          "type": "string"
