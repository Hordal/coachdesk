      "type": "string"
    },
    "definition_version": {
      "title": "Definition Version",
      "type": "string"
    },
    "duration_us": {
      "exclusiveMinimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "exchanges": {
