    "Event": {
      "additionalProperties": true,
      "description": "팀 동작 검출 모델의 사건 형식(phase1b_v1)을 그대로 따른다.\n\n필드 이름·의미는 팀 출력(`action_candidates.jsonl`)과 같다. 팀 형식에 없는 필드는 서버가 쓰는 확장이다:\n`event_id`(집계·관계·근거가 가리키는 ID. 가져오기 입력(EventIn)에서는 비우면 서버가 만든다), `target_participant_id`(상대 선수),\n`evidence_ref`(영상 구간 근거), `confidence`, 접촉면·상태 참조. 그라운드 필드(33)는 `event_label`이 그라운드 사건일 때만 쓴다.",
      "properties": {
        "arm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arm"
        },
        "bottom_participant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bottom Participant Id"
        },
        "clip_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Id"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "내부 판정·평가용. 화면의 정확도가 아니다",
          "title": "Confidence"
        },
        "contamination_gates": {
          "items": {
            "type": "string"
          },
          "title": "Contamination Gates",
          "type": "array"
        },
        "end_frame_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Frame Index"
        },
        "end_timestamp_us": {
          "description": "원본 재생 시작 기준 정수 마이크로초",
          "minimum": 0,
          "title": "End Timestamp Us",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_label": {
          "title": "Event Label",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceMeasure"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Path"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "finish_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finish Context"
        },
        "input_joint_quality": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Joint Quality"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "participant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Id"
        },
        "phase_marks": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Marks"
        },
        "post_state_refs": {
          "items": {
            "type": "string"
          },
          "title": "Post State Refs",
          "type": "array"
        },
        "pre_state_refs": {
