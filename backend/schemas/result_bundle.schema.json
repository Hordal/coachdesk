        },
        "numerator_refs": {
          "items": {
            "type": "string"
          },
          "title": "Numerator Refs",
          "type": "array"
        },
        "question_code": {
          "title": "Question Code",
          "type": "string"
        },
        "ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
