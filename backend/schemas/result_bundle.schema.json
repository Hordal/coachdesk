              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Surface"
        },
        "start_frame_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Frame Index"
        },
        "start_timestamp_us": {
          "description": "원본 재생 시작 기준 정수 마이크로초",
          "minimum": 0,
          "title": "Start Timestamp Us",
          "type": "integer"
        },
        "status": {
          "enum": [
            "CANDIDATE",
            "VALID",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "synthetic": {
          "default": false,
          "title": "Synthetic",
          "type": "boolean"
        },
        "target_participant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Participant Id"
        },
        "target_surface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Surface"
        },
        "top_participant_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Participant Id"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "tracklet_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracklet Ref"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "event_label",
        "status",
        "start_timestamp_us",
        "end_timestamp_us"
      ],
      "title": "Event",
      "type": "object"
    },
