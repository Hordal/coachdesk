            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contact Region Condition"
        },
        "counting_unit": {
          "title": "Counting Unit",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
