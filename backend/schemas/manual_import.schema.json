    "StatesFromPoses": {
      "additionalProperties": false,
      "description": "가져온 팀 연구 포즈에서 서버가 가드 상태 구간을 만들어 더하도록 요청한다(25의 4-3절).\n\n상대가 있는 방향은 입력으로만 받는다. 화면 위치나 번호로 추측하지 않으며, 없는 후보는 `left_hand`·`right_hand` 상태만 만들고\n`front_hand`·`rear_hand`는 만들지 않는다(그러면 가드 복귀 판정은 입력 부족으로 판단 불가가 된다).",
      "properties": {
        "opponent_direction": {
          "additionalProperties": {
            "enum": [
              1,
              -1
            ],
            "type": "integer"
          },
          "description": "`candidate:N` → 상대가 화면 오른쪽(1)·왼쪽(-1)에 있는 방향. 그 후보의 앞손·뒷손 상태를 만드는 데만 쓴다",
          "title": "Opponent Direction",
          "type": "object"
        },
        "set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "쓸 포즈 묶음. 비우면 이 영상에서 가장 최근에 가져온 것",
          "title": "Set Id"
        }
      },
      "title": "StatesFromPoses",
      "type": "object"
    }
  },
  "$id": "urn:fight-review:schema:manual-import:0.3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "사람이 입력한 사건·판정(manual 모드)의 가져오기 파일.\n\n영상 번호, 길이, 종목, 데이터 종류는 서버가 영상에서 채우므로 받지 않는다.\n집계는 정의만 받고 값은 서버가 계산하며, 주장의 문장은 읽을 때 템플릿으로 만든다.",
  "properties": {
    "aggregates": {
      "items": {
        "$ref": "#/$defs/AggregateSpec"
      },
      "title": "Aggregates",
      "type": "array"
    },
    "annotation_source": {
      "description": "입력한 사람이나 도구. 예: 'labeler-a', 'cvat-export'",
      "title": "Annotation Source",
      "type": "string"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/Assessment"
      },
      "title": "Assessments",
      "type": "array"
    },
    "definition_version": {
      "title": "Definition Version",
      "type": "string"
    },
    "derive": {
      "description": "서버가 사건·상태 구간에서 판정·집계·주장을 만들어 더할 분석 규칙(02B). 같은 대상·질문의 판정을 직접 입력하면 중복으로 거절한다",
      "items": {
        "enum": [
          "rear_guard_return",
          "balance_recovery"
        ],
        "type": "string"
      },
      "title": "Derive",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventIn"
      },
      "title": "Events",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "exchanges": {
      "items": {
        "$ref": "#/$defs/Exchange"
      },
      "title": "Exchanges",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "metric_samples": {
      "items": {
        "$ref": "#/$defs/MetricSample"
      },
      "title": "Metric Samples",
      "type": "array"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "participants": {
      "items": {
        "$ref": "#/$defs/Participant"
      },
      "title": "Participants",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/EventRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario"
    },
    "state_intervals": {
      "items": {
        "$ref": "#/$defs/StateInterval"
      },
      "title": "State Intervals",
      "type": "array"
    },
    "states_from_poses": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatesFromPoses"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "가져온 포즈로 가드 상태 구간을 만들어 `state_intervals`에 더한다"
    }
