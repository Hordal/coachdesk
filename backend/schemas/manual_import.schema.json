            "UNRESOLVED"
          ],
          "title": "Role",
          "type": "string"
        },
        "track_ids": {
          "description": "이 선수에 연결된 추적 번호. 한 선수에 여러 개일 수 있다",
          "items": {
            "type": "integer"
          },
          "title": "Track Ids",
          "type": "array"
        },
        "user_designated": {
          "default": false,
          "title": "User Designated",
          "type": "boolean"
        }
      },
      "required": [
        "participant_id",
        "role"
      ],
      "title": "Participant",
      "type": "object"
    },
    "StateInterval": {
      "additionalProperties": false,
      "properties": {
        "body_part": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Part"
        },
        "end_us": {
          "description": "원본 재생 시작 기준 정수 마이크로초",
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "participant_id": {
          "title": "Participant Id",
          "type": "string"
        },
        "start_us": {
          "description": "원본 재생 시작 기준 정수 마이크로초",
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "state_category": {
          "title": "State Category",
          "type": "string"
        },
